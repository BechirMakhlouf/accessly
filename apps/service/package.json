{
  "name": "@accessly/service",
  "type": "module",
  "scripts": {
    "init-local": "shx cp .env.example .env.local",
    "dev": "tsx watch src/index.ts",
    "build": "node build.ts",
    "start": "node dist/index.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@accessly/types": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "@slack/web-api": "^7.9.3",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "dotenv": "^17.2.2",
    "hono": "^4.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@accessly/config": "workspace:*",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.11",
    "eslint": "^9.36.0",
    "prettier": "^3.3.3",
    "shx": "^0.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
