{
  "name": "accessly",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "-- NEXT --": "",
    "init-local": "npm install && shx cp env.example .env.local",
    "dev": "supabase start && next dev --turbopack",
    "devs": "supabase start && next dev --turbopack --experimental-https",
    "build": "next build",
    "build:no-lint": "next build --no-lint",
    "start": "next start",
    "lint": "eslint .",
    "-- SUPABASE --": "",
    "supabase:types:local": "supabase gen types typescript --local --schema public,auth,storage > src/types/database.types.ts",
    "supabase:stop": "supabase stop",
    "supabase:start": "supabase start",
    "supabase:restart": "run-s supabase:stop supabase:start",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:diff": "supabase db diff",
    "supabase:db:gen-migration": "tsx scripts/migration-workflow.ts",
    "supabase:migration:up": "supabase migration up && npm run supabase:types:local",
    "-- SCRIPTS --": "",
    "create-test-users": "tsx scripts/create-test-users.ts",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "validate:db-types": "tsx scripts/validate-db-types.ts",
    "validate:db-types:update": "tsx scripts/validate-db-types.ts --update",
    "check:db-types": "tsx scripts/check-db-types.ts",
    "-- TESTS --": "",
    "test:db": "supabase test db",
    "-- CI --": "",
    "ci:lint": "npm run lint",
    "ci:type-check": "npx tsc --noEmit",
    "ci:build": "npm run build",
    "ci:full": "run-s ci:lint ci:type-check ci:build",
    "-- HUSKY --": "",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.3",
    "@react-email/render": "^1.2.3",
    "@supabase-cache-helpers/postgrest-react-query": "^1.13.6",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-query-devtools": "^5.89.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "botid": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "jiti": "^2.5.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.16",
    "next": "^15.6.0-canary.20",
    "next-intl": "^4.3.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.63.0",
    "react-phone-number-input": "^3.4.12",
    "resend": "^6.1.0",
    "sonner": "^2.0.7",
    "supabase-error-translator-js": "^3.0.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^15.5.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
