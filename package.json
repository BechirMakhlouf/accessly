{
  "name": "accessly",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "-- NEXT --": "",
    "init": "npm install && shx cp env.example .env.local",
    "dev": "next dev --turbopack",
    "devs": "next dev --turbopack --experimental-https",
    "build": "next build",
    "build:no-lint": "next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "-- SUPABASE --": "",
    "supabase:types:local": "supabase gen types typescript --local --schema public,auth,storage > src/types/database.types.ts",
    "supabase:stop": "supabase stop",
    "supabase:start": "supabase start",
    "supabase:restart": "run-s supabase:stop supabase:start",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:diff": "supabase db diff",
    "supabase:db:gen-migration": "tsx scripts/migration-workflow.ts",
    "supabase:migration:up": "supabase migration up && npm run supabase:types:local",
    "-- SCRIPTS --": "",
    "create-test-users": "tsx scripts/create-test-users.ts",
    "-- TESTS --": "",
    "test:db": "supabase test db",
    "-- CI --": "",
    "ci:lint": "npm run lint",
    "ci:type-check": "npx tsc --noEmit",
    "ci:build": "npm run build",
    "ci:full": "run-s ci:lint ci:type-check ci:build",
    "-- HUSKY --": "",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.10.0",
    "@supabase-cache-helpers/postgrest-react-query": "^1.13.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "botid": "^1.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "jiti": "^2.4.2",
    "lucide-react": "^0.522.0",
    "motion": "^12.23.12",
    "next": "^15.5.0",
    "next-intl": "^4.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.61.1",
    "react-phone-number-input": "^3.4.12",
    "resend": "^6.0.2",
    "sonner": "^2.0.6",
    "supabase-error-translator-js": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^20.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.3.4",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "supabase": "^2.39.2",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vercel": "^32.0.1"
  }
}
