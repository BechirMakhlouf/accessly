{
  "name": "accessly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prettier": "@accessly/config/prettier",
  "scripts": {
    "init-local": "turbo run init-local",
    "build": "turbo run build",
    "dev": "supabase start && turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "-- WEB --": "",
    "web:install": "pnpm install --filter=@accessly/web --frozen-lockfile",
    "web:build": "turbo run build --filter=@accessly/web",
    "web:test": "pnpm --filter @accessly/web test",
    "web:dev": "pnpm --filter @accessly/web dev",
    "web:format": "pnpm --filter @accessly/web format",
    "-- SERVICE --": "",
    "service:build": "turbo run build --filter=@accessly/service",
    "service:install": "pnpm install --filter=@accessly/service --frozen-lockfile",
    "service:test": "pnpm --filter @accessly/service test",
    "service:dev": "pnpm --filter @accessly/service dev",
    "service:format": "pnpm --filter @accessly/service format",
    "-- SUPABASE --": "",
    "supabase:types:local": "supabase gen types typescript --local --schema public,auth,storage > packages/types/database.types.ts",
    "supabase:stop": "supabase stop",
    "supabase:start": "supabase start",
    "supabase:restart": "run-s supabase:stop supabase:start",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:diff": "supabase db diff",
    "supabase:db:gen-migration": "tsx scripts/migration-workflow.ts",
    "supabase:migration:up": "supabase migration up && pnpm run supabase:types:local",
    "-- SCRIPTS --": "",
    "create-test-users": "tsx scripts/create-test-users.ts",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "validate:db-types": "tsx scripts/validate-db-types.ts",
    "validate:db-types:update": "tsx scripts/validate-db-types.ts --update",
    "check:db-types": "tsx scripts/check-db-types.ts",
    "-- TESTS --": "",
    "test:db": "supabase test db",
    "-- CI --": "",
    "ci:lint": "pnpm run lint",
    "ci:type-check": "pnpm run type-check",
    "ci:build": "pnpm run build",
    "ci:full": "run-s ci:lint ci:type-check ci:build"
  },
  "devDependencies": {
    "@turbo/gen": "^2.7.2",
    "@types/node": "^24.10.4",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "shx": "^0.4.0",
    "supabase": "latest",
    "turbo": "^2.7.2",
    "typescript": "^5.9.2"
  }
}
