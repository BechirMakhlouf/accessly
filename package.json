{
  "name": "accessly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "supabase start && turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "format:root": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:root:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "-- BUILD --": "",
    "build:web": "turbo run build --filter=@accessly/web",
    "build:service": "turbo run build --filter=@accessly/service",
    "-- SUPABASE --": "",
    "supabase:types:local": "cd apps/web && supabase gen types typescript --local --schema public,auth,storage > src/types/database.types.ts",
    "supabase:stop": "cd apps/web && supabase stop",
    "supabase:start": "cd apps/web && supabase start",
    "supabase:restart": "run-s supabase:stop supabase:start",
    "supabase:db:reset": "cd apps/web && supabase db reset",
    "supabase:db:diff": "cd apps/web && supabase db diff",
    "supabase:db:gen-migration": "cd apps/web && tsx scripts/migration-workflow.ts",
    "supabase:migration:up": "cd apps/web && supabase migration up && pnpm run supabase:types:local",
    "-- SCRIPTS --": "",
    "create-test-users": "cd apps/web && tsx scripts/create-test-users.ts",
    "validate:migrations": "cd apps/web && tsx scripts/validate-migrations.ts",
    "validate:db-types": "cd apps/web && tsx scripts/validate-db-types.ts",
    "validate:db-types:update": "cd apps/web && tsx scripts/validate-db-types.ts --update",
    "check:db-types": "cd apps/web && tsx scripts/check-db-types.ts",
    "-- TESTS --": "",
    "test:db": "cd apps/web && supabase test db",
    "-- CI --": "",
    "ci:lint": "pnpm run lint",
    "ci:type-check": "pnpm run type-check",
    "ci:build": "pnpm run build",
    "ci:full": "run-s ci:lint ci:type-check ci:build"
  },
  "devDependencies": {
    "@accessly/eslint-config": "workspace:*",
    "@accessly/prettier-config": "workspace:*",
    "@accessly/typescript-config": "workspace:*",
    "@turbo/gen": "^1.12.4",
    "eslint": "^9.36.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.9.2",
    "supabase": "latest"
  }
}
