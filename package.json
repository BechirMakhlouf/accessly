    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.3",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "npm-check-updates": "^18.3.0",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "supabase": "^2.40.7",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}